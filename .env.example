# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file or your real credentials to source control.

# Flask session secret (use any long random string)
SECRET_KEY=change-this-to-a-random-secret-key

# Gmail SMTP credentials used to email the admin when an order is placed.
# MAIL_PASSWORD must be a Gmail "App Password", NOT your normal Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Address that receives the "New PriorityX Order" notification emails.
# Defaults to MAIL_USERNAME if not set.
ADMIN_EMAIL=admin@example.com
